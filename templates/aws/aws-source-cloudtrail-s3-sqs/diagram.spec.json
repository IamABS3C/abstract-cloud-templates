{
 "frame": {
  "title": "CloudTrail events reach Abstract through S3 and SQS",
  "subtitle": "The trail writes log files to S3 and announces each one; Abstract polls the queue and reads the file",
  "cloud_label": "Your AWS account",
  "height": 700,
  "abstract_y": 200,
  "abstract_sublabel": "polls SQS, reads S3\nparses to ACS",
  "integration_y": 547
 },
 "theme": "dark",
 "pages": [
  {
   "name": "CloudTrail logs",
   "nodes": [
    {
     "id": "trail",
     "label": "CloudTrail trail",
     "sublabel": "multi-region\nmanagement events",
     "icon": "aws:cloudtrail",
     "x": 60,
     "y": 110,
     "builds": [
      "AWS::CloudTrail::Trail"
     ]
    },
    {
     "id": "bucket",
     "label": "Log bucket",
     "sublabel": "hardened, versioned\nlifecycle expiry",
     "icon": "aws:s3",
     "x": 330,
     "y": 110,
     "builds": [
      "AWS::S3::Bucket",
      "AWS::S3::BucketPolicy"
     ]
    },
    {
     "id": "topic",
     "label": "SNS topic",
     "sublabel": "one message per log file",
     "icon": "aws:sns",
     "x": 330,
     "y": 330,
     "builds": [
      "AWS::SNS::Topic",
      "AWS::SNS::TopicPolicy"
     ]
    },
    {
     "id": "queue",
     "label": "SQS queue",
     "sublabel": "Abstract polls here",
     "icon": "aws:sqs",
     "x": 600,
     "y": 330,
     "builds": [
      "AWS::SQS::Queue",
      "AWS::SNS::Subscription"
     ]
    },
    {
     "id": "dlq",
     "label": "Dead-letter queue",
     "sublabel": "after repeated failures",
     "icon": "aws:sqs",
     "x": 600,
     "y": 540,
     "builds": [
      "DeadLetterQueue"
     ]
    },
    {
     "id": "kms",
     "label": "KMS key",
     "sublabel": "optional, encrypts\nbucket and queue",
     "icon": "aws:key_management_service",
     "x": 60,
     "y": 540,
     "builds": [
      "AWS::KMS::Key"
     ]
    },
    {
     "id": "alarms",
     "label": "CloudWatch alarms",
     "sublabel": "optional: dead letters,\nqueue age",
     "icon": "aws:cloudwatch",
     "x": 330,
     "y": 540,
     "builds": [
      "AWS::CloudWatch::Alarm"
     ]
    },
    {
     "id": "role",
     "label": "IAM role",
     "sublabel": "trusts Abstract only,\nwith an External ID",
     "icon": "aws:role",
     "x": 870,
     "y": 540,
     "builds": [
      "AWS::IAM::Role"
     ]
    }
   ],
   "edges": [
    {
     "from": "trail",
     "to": "bucket",
     "label": "log files"
    },
    {
     "from": "trail",
     "to": "topic",
     "label": "file delivered",
     "exit": [
      1,
      0.85
     ],
     "entry": [
      0,
      0.5
     ]
    },
    {
     "from": "topic",
     "to": "queue",
     "label": "subscription"
    },
    {
     "from": "queue",
     "to": "abstract",
     "label": "poll",
     "entry": [
      0,
      0.7
     ],
     "label_x": -0.3
    },
    {
     "from": "bucket",
     "to": "abstract",
     "label": "GetObject",
     "entry": [
      0,
      0.3
     ],
     "label_x": -0.5
    },
    {
     "from": "queue",
     "to": "dlq",
     "label": "undeliverable",
     "tone": "muted",
     "dashed": true,
     "exit": [
      1,
      0.9
     ],
     "entry": [
      1,
      0.3
     ]
    },
    {
     "from": "abs-integration",
     "to": "role",
     "label": "AssumeRole + External ID",
     "tone": "amber",
     "dashed": true,
     "exit": [
      0,
      0.5
     ],
     "entry": [
      1,
      0.5
     ]
    }
   ]
  }
 ]
}
