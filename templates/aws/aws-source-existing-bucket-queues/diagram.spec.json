{
 "frame": {
  "title": "One queue per source, for a bucket you already have",
  "subtitle": "A routing layer sends each prefix to its own queue; Abstract polls each queue and reads the bucket",
  "cloud_label": "Your AWS account",
  "height": 700,
  "abstract_y": 200,
  "abstract_sublabel": "one configuration\nper queue",
  "integration_y": 547
 },
 "theme": "dark",
 "pages": [
  {
   "name": "Existing bucket",
   "nodes": [
    {
     "id": "bucket",
     "label": "Security bucket",
     "sublabel": "holds several sources\nunder different prefixes",
     "icon": "aws:s3",
     "x": 60,
     "y": 110,
     "existing": true
    },
    {
     "id": "routing",
     "label": "Routing layer",
     "sublabel": "pick one: bucket notification,\nSNS fan-out or EventBridge rule",
     "icon": "aws:sns",
     "x": 330,
     "y": 330,
     "builds": [
      "aws_s3_bucket_notification",
      "aws_sns_topic",
      "aws_cloudwatch_event_rule"
     ]
    },
    {
     "id": "queues",
     "label": "Source queues",
     "sublabel": "one queue for each prefix",
     "icon": "aws:sqs",
     "x": 600,
     "y": 330,
     "builds": [
      "aws_sqs_queue"
     ]
    },
    {
     "id": "dlq",
     "label": "Dead-letter queue",
     "sublabel": "one per source",
     "icon": "aws:sqs",
     "x": 600,
     "y": 540,
     "builds": [
      "aws_sqs_queue"
     ]
    },
    {
     "id": "alarms",
     "label": "CloudWatch alarms",
     "sublabel": "optional: one per source,\nwhen its dead-letter queue fills",
     "icon": "aws:cloudwatch",
     "x": 330,
     "y": 540,
     "builds": [
      "aws_cloudwatch_metric_alarm"
     ]
    },
    {
     "id": "role",
     "label": "IAM role",
     "sublabel": "one role for every\nconfiguration, with an External ID",
     "icon": "aws:role",
     "x": 870,
     "y": 540,
     "builds": [
      "aws_iam_role"
     ]
    }
   ],
