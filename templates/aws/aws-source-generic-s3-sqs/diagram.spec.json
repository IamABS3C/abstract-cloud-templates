{
 "frame": {
  "title": "Any S3 log source reaches Abstract through S3 and SQS",
  "subtitle": "Your own shipper writes objects to the bucket; S3 queues a message per object and Abstract reads it",
  "cloud_label": "Your AWS account",
  "height": 700,
  "abstract_y": 200,
  "abstract_sublabel": "polls SQS, reads S3\nparses to ACS",
