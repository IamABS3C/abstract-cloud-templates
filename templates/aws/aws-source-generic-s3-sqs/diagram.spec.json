     "id": "prod",
     "label": "Your log shipper",
     "sublabel": "anything that writes objects;\nthe stack builds no producer",
     "icon": "aws:traditional_server",
     "x": 60,
     "y": 110,
     "existing": true
    },
    {
     "id": "bucket",
     "label": "Log bucket",
     "sublabel": "hardened, versioned\nlifecycle expiry",
     "icon": "aws:s3",
     "x": 330,
     "y": 110,
     "builds": [
      "AWS::S3::Bucket",
      "AWS::S3::BucketPolicy"
     ]
    },
    {
     "id": "topic",
     "label": "SNS topic",
     "sublabel": "optional fan-out\n(S3ToSNSToSQS)",
     "icon": "aws:sns",
     "x": 330,
     "y": 330,
     "builds": [
      "AWS::SNS::Topic",
      "AWS::SNS::TopicPolicy"
     ]
    },
    {
     "id": "queue",
     "label": "SQS queue",
     "sublabel": "Abstract polls here",
     "icon": "aws:sqs",
     "x": 600,
     "y": 330,
     "builds": [
      "AWS::SQS::Queue",
      "AWS::SQS::QueuePolicy"
     ]
    },
    {
     "id": "dlq",
     "label": "Dead-letter queue",
     "sublabel": "after repeated failures",
     "icon": "aws:sqs",
     "x": 600,
     "y": 540,
     "builds": [
      "DeadLetterQueue"
     ]
    },
    {
     "id": "kms",
     "label": "KMS key",
     "sublabel": "optional, encrypts\nbucket and queue",
     "icon": "aws:key_management_service",
     "x": 60,
     "y": 540,
     "builds": [
      "AWS::KMS::Key"
     ]
    },
    {
     "id": "alarms",
     "label": "CloudWatch alarms",
     "sublabel": "optional: dead letters,\nqueue age",
     "icon": "aws:cloudwatch",
     "x": 330,
     "y": 540,
     "builds": [
      "AWS::CloudWatch::Alarm"
     ]
    },
    {
     "id": "role",
     "label": "IAM role",
     "sublabel": "trusts Abstract only,\nwith an External ID",
     "icon": "aws:role",
     "x": 870,
     "y": 540,
     "builds": [
      "AWS::IAM::Role"
     ]
    }
