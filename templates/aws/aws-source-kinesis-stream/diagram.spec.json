     "entry": [
      0,
      0.5
     ],
     "label_x": -0.3
    },
    {
     "from": "user",
     "to": "secret",
     "label": "key stored",
     "tone": "muted",
     "dashed": true
    },
    {
     "from": "abs-integration",
     "to": "role",
     "label": "AssumeRole + External ID",
     "tone": "amber",
     "dashed": true,
     "exit": [
      0,
