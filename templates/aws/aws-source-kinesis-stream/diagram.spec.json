{
 "frame": {
  "title": "A Kinesis data stream read directly by Abstract",
  "subtitle": "No bucket or queue: Abstract reads records from the stream with a role the template builds",
  "cloud_label": "Your AWS account",
  "height": 700,
  "abstract_y": 100,
  "abstract_sublabel": "reads stream records\nparses to ACS",
  "integration_y": 547
 },
 "theme": "dark",
 "pages": [
  {
   "name": "Kinesis stream",
   "nodes": [
    {
     "id": "prod",
     "label": "Your producers",
     "sublabel": "whatever writes to the stream",
     "icon": "aws:traditional_server",
     "x": 60,
     "y": 110,
     "existing": true
    },
    {
     "id": "stream",
     "label": "Kinesis data stream",
     "sublabel": "created only when StreamMode=CreateNew;\notherwise your existing stream",
     "icon": "aws:kinesis_data_streams",
     "x": 330,
     "y": 110,
     "builds": [
      "AWS::Kinesis::Stream"
     ]
    },
    {
     "id": "user",
     "label": "IAM user + access key",
     "sublabel": "optional alternative:\nAuthMode=AccessKey",
     "icon": "aws:long_term_security_credential",
     "x": 60,
     "y": 540,
     "builds": [
      "AWS::IAM::User"
     ]
    },
    {
     "id": "secret",
     "label": "Secrets Manager",
     "sublabel": "optional: holds the\naccess key",
     "icon": "aws:secrets_manager",
     "x": 330,
     "y": 540,
     "builds": [
      "AWS::SecretsManager::Secret"
     ]
    },
    {
     "id": "ssm",
     "label": "SSM parameter",
     "sublabel": "optional: publishes\nthe role ARN",
     "icon": "aws:parameter_store",
     "x": 600,
     "y": 540,
     "builds": [
      "AWS::SSM::Parameter"
     ]
    },
    {
     "id": "role",
     "label": "IAM role",
     "sublabel": "reads the stream only;\ntrusts Abstract with an External ID",
     "icon": "aws:role",
     "x": 870,
     "y": 540,
     "builds": [
      "AbstractRole"
     ]
    }
   ],
   "edges": [
    {
     "from": "prod",
     "to": "stream",
     "label": "records"
    },
    {
     "from": "stream",
     "to": "abstract",
