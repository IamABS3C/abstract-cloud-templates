{
 "frame": {
  "title": "Security Hub findings reach Abstract through EventBridge and Firehose",
  "subtitle": "An EventBridge rule hands each finding to Firehose, which writes them one per line to a new bucket that notifies a queue",
  "cloud_label": "Your AWS account",
  "height": 700,
  "abstract_y": 150,
  "integration_y": 547,
  "abstract_sublabel": "polls the queue, reads NDJSON\nparses ASFF or OCSF to ACS"
 },
