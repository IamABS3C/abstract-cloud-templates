// ASIM schema: ProcessEvent (schema version 0.1.4)
// outputStream: Microsoft-ASimProcessEventLogs
//
// Maps Abstract Common Schema (ACS) events for process creation and termination on endpoints. Selected by event.category (process) with a process name, executable or command line.
// Microsoft's built-in _Im_ProcessEvent parser reads the target table, so Microsoft's ASIM
// analytics rules, hunting queries and workbooks see these events from any vendor.
source
// Abstract findings and alerts are detections, not activity: keep them out of the activity tables.
| where tolower(case(isnotempty(acs_type), acs_type, tostring(['type']))) !in ('finding', 'alert')
| extend _category = tolower(tostring(event.category))
| where _category has 'process' and (isnotempty(tostring(process.name)) or isnotempty(tostring(process.executable)) or isnotempty(tostring(process.command_line)))
// When the event names a target process (one process acting on another), that is the target and
// the event's process is the actor; otherwise the event's process is the target and its parent acts.
| extend _hasTarget = isnotempty(tostring(process.target.name)) or isnotempty(tostring(process.target.executable)) or isnotempty(tostring(process.target.pid))
| extend _proc = case(isnotempty(tostring(process.executable)), tostring(process.executable), tostring(process.name)), _parent = case(isnotempty(tostring(process.parent.executable)), tostring(process.parent.executable), tostring(process.parent.name))
| extend _action = tolower(tostring(action)), _outcome = tolower(tostring(event.outcome)), _sev = tolower(case(isnotempty(severity), severity, tostring(event.severity)))
| extend _result = case(_outcome in ('success', 'succeeded', 'allowed', 'allow'), 'Success', _outcome in ('failure', 'failed', 'fail', 'denied', 'blocked', 'deny'), 'Failure', _outcome == 'partial', 'Partial', 'NA')
| extend _time = case(isnotnull(['timestamp']), ['timestamp'], isnotnull(ingested_time), ingested_time, now())
// Azure restamps anything older than two days with its arrival time. A replay, backfill or
// long catch-up would then look like live activity to every ASIM rule, so it stays out of
// the ASIM tables (it still lands in the Abstract table).
| where _time > ago(2d)
| project
    TimeGenerated = _time,
    EventCount = iif(isnull(aggregation_count) or aggregation_count < 1, toint(1), toint(aggregation_count)),
    EventStartTime = case(isnotnull(todatetime(event.start)), todatetime(event.start), isnotnull(aggregation_start), aggregation_start, _time),
    EventEndTime = case(isnotnull(todatetime(event.end)), todatetime(event.end), isnotnull(aggregation_end), aggregation_end, _time),
    EventResult = _result,
    EventOriginalResultDetails = tostring(event.reason),
    EventOriginalType = tostring(action),
    EventOriginalUid = case(isnotempty(tostring(event.id)), tostring(event.id), tostring(['id'])),
    EventSeverity = case(_sev in ('critical', 'high'), 'High', _sev in ('medium', 'warn', 'warning'), 'Medium', _result == 'Failure' or _sev in ('low', 'error'), 'Low', 'Informational'),
    EventOriginalSeverity = case(isnotempty(severity), severity, tostring(event.severity)),
    EventMessage = message,
    EventProduct = product,
    EventVendor = vendor,
    EventSchemaVersion = '0.1.4',
    DvcHostname = host_name,
    DvcIpAddr = case(isnotempty(host_ipv4), host_ipv4, host_ipv6),
    EventType = iif(_action contains 'terminat' or _action contains 'exited' or _action contains 'killed' or _action contains 'stopped' or _action has 'exit' or _action has 'stop' or _action has 'end' or _action has 'kill', 'ProcessTerminated', 'ProcessCreated'),
    TargetProcessName = iif(_hasTarget, case(isnotempty(tostring(process.target.executable)), tostring(process.target.executable), tostring(process.target.name)), _proc),
    TargetProcessCommandLine = iif(_hasTarget, tostring(process.target.command_line), tostring(process.command_line)),
    TargetProcessId = iif(_hasTarget, tostring(tolong(process.target.pid)), tostring(tolong(process.pid))),
    TargetProcessCurrentDirectory = iif(_hasTarget, '', tostring(process.working_directory)),
    ActingProcessName = iif(_hasTarget, _proc, _parent),
    ActingProcessCommandLine = iif(_hasTarget, tostring(process.command_line), tostring(process.parent.command_line)),
    ActingProcessId = iif(_hasTarget, tostring(tolong(process.pid)), tostring(tolong(process.parent.pid))),
    ParentProcessName = iif(_hasTarget, _parent, ''),
    ParentProcessId = iif(_hasTarget, tostring(tolong(process.parent.pid)), ''),
    ActorUsername = case(isnotempty(tostring(process.username)), tostring(process.username), user_name),
    ActorUsernameType = case(isempty(user_name), '', user_name has '@', 'UPN', user_name contains '\\', 'Windows', 'Simple'),
    TargetUsername = case(_hasTarget and isnotempty(tostring(process.target.username)), tostring(process.target.username), isnotempty(tostring(process.username)), tostring(process.username), user_name),
    TargetUsernameType = case(isempty(user_name), '', user_name has '@', 'UPN', user_name contains '\\', 'Windows', 'Simple'),
    AdditionalFields = pack('AbstractEventId', tostring(['id']), 'AbstractCategory', tostring(event.category), 'AbstractDataset', tostring(data_stream.dataset), 'AbstractMatchedRules', matched_rules)
