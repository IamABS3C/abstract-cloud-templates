{
 "frame": {
  "title": "Bicep creates the app, then Abstract delivers to Sentinel",
  "subtitle": "The Microsoft Graph Bicep extension makes the app registration, then the standard destination template is called",
  "cloud_label": "Your resource group",
  "height": 600,
  "abstract_y": 151,
  "abstract_label": "Abstract platform",
  "abstract_sublabel": "sends processed events\nto your workspace"
 },
 "theme": "dark",
 "pages": [
  {
   "name": "Sentinel destination, app by Graph",
   "nodes": [
    {
     "id": "app",
     "label": "App registration",
     "sublabel": "no API permissions,\ncreated as the deployer",
     "icon": "azure:identity/App_Registrations",
     "x": 60,
     "y": 160,
     "builds": [
      "Microsoft.Graph/applications@"
     ]
    },
    {
     "id": "sp",
     "label": "Service principal",
     "sublabel": "becomes the DCR role's\nprincipal",
     "icon": "azure:identity/Enterprise_Applications",
     "x": 330,
     "y": 160,
     "builds": [
      "Microsoft.Graph/servicePrincipals@"
     ]
    },
    {
     "id": "mod",
     "label": "Standard Sentinel destination",
     "sublabel": "endpoint, rule, custom table and\nrole (the destination template)",
     "icon": "azure:other/Data_Collection_Rules",
     "x": 600,
     "y": 160,
     "builds": [
      "'../azure-destination-sentinel/main.bicep'"
     ]
    },
    {
     "id": "script",
     "label": "Secret script",
     "sublabel": "creates the client secret\n(optional, automateSecret)",
     "icon": "azure:management_governance/Automation_Accounts",
     "x": 870,
     "y": 360,
     "builds": [
      "Microsoft.Resources/deploymentScripts@"
     ]
    },
    {
     "id": "kv",
     "label": "Key Vault",
     "sublabel": "holds the secret\n(optional)",
     "icon": "azure:security/Key_Vaults",
     "x": 600,
     "y": 360,
     "builds": [
      "Microsoft.KeyVault/vaults@"
     ]
    },
    {
     "id": "writer",
     "label": "Secret-writer identity",
     "sublabel": "owns only this app\n(optional)",
     "icon": "azure:identity/Managed_Identities",
     "x": 330,
     "y": 360,
     "builds": [
      "Microsoft.ManagedIdentity/userAssignedIdentities@"
     ]
    }
   ],
   "edges": [
    {
     "from": "app",
     "to": "sp",
     "label": "service principal"
    },
    {
     "from": "sp",
     "to": "mod",
     "label": "principalId",
     "label_x": -0.1
    },
    {
     "from": "abstract",
     "to": "mod",
     "label": "sends events",
     "exit": [
      0,
      0.5
     ],
     "entry": [
      1,
      0.5
     ],
     "label_x": 0.2
    },
    {
     "from": "script",
     "to": "kv",
     "label": "stores secret",
     "tone": "muted",
     "dashed": true,
     "exit": [
      0,
      0.5
     ],
     "entry": [
      1,
      0.5
     ]
    },
    {
     "from": "writer",
     "to": "kv",
     "label": "runs the script as",
     "tone": "muted",
     "dashed": true,
     "exit": [
      1,
      0.5
     ],
     "entry": [
      0,
      0.5
     ]
    }
   ]
  }
 ]
}
