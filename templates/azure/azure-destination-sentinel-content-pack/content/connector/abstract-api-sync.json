{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "title": "Abstract Security - API Sync (multi-endpoint connector)",
    "description": "One scheduled Logic App that syncs multiple Abstract API endpoints into Sentinel custom tables so the Competitive & TCO workbook can compare live: Insights (AbstractInsights_CL), tune-at-source filters (AbstractTuningFilters_CL), pipeline IO metrics raw-in/forwarded-out (AbstractPipelineMetrics_CL), and detection effectiveness (AbstractDetectionEffectiveness_CL). Endpoints confirmed against the Abstract Security API. Toggle branches by editing the definition; add endpoints with the same HTTP->Select->Send pattern.",
    "prerequisites": "Abstract API key + vendor account id; Log Analytics workspace id + primary key. Prefer Key Vault.",
    "author": "Abstract Security - Solutions Engineering"
  },
  "parameters": {
    "PlaybookName": {
      "type": "string",
      "defaultValue": "Abstract-API-Sync"
    },
    "abstractBaseUrl": {
      "type": "string",
      "defaultValue": "https://api.abstractsecurity.app"
    },
    "abstractVendorAccountId": {
      "type": "string"
    },
    "workspaceId": {
      "type": "string",
      "metadata": {
        "description": "Log Analytics workspace GUID."
      }
    },
    "workspaceKey": {
      "type": "securestring",
      "metadata": {
        "description": "Log Analytics primary key. Prefer Key Vault."
      }
    },
    "pollFrequencyMinutes": {
      "type": "int",
      "defaultValue": 60
    },
    "keyVaultSecretUri": {
      "type": "string",
      "metadata": {
        "description": "Key Vault secret URI for the Abstract API key; fetched at runtime via the Logic App's managed identity."
      }
    }
  },
  "variables": {
    "c": "azureloganalyticsdatacollector-Abstract-API-Sync"
  },
  "resources": [
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('c')]",
      "location": "[resourceGroup().location]",
      "kind": "V1",
      "properties": {
        "displayName": "[variables('c')]",
        "parameterValues": {
          "username": "[parameters('workspaceId')]",
          "password": "[parameters('workspaceKey')]"
        },
        "api": {
          "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/azureloganalyticsdatacollector')]"
        }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2017-07-01",
      "name": "[parameters('PlaybookName')]",
      "location": "[resourceGroup().location]",
      "identity": {
        "type": "SystemAssigned"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', variables('c'))]"
      ],
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": {
              "type": "Object"
            },
            "abstractBaseUrl": {
              "type": "string"
            },
            "abstractVendorAccountId": {
              "type": "string"
            },
            "pollFrequencyMinutes": {
              "type": "int"
            },
            "keyVaultSecretUri": {
              "type": "string"
            }
          },
          "triggers": {
            "Recurrence": {
              "type": "Recurrence",
              "recurrence": {
                "frequency": "Minute",
                "interval": "@parameters('pollFrequencyMinutes')"
              }
            }
          },
          "actions": {
            "Get_Insights": {
              "type": "Http",
              "runtimeConfiguration": {
                "secureData": {
                  "properties": [
                    "inputs"
                  ]
                }
              },
              "inputs": {
                "method": "GET",
                "uri": "@{parameters('abstractBaseUrl')}/v1/insights/",
                "headers": {
                  "Authorization": "Bearer @{body('Get_Abstract_key')?['value']}",
                  "X-AS-Vendor-Account-ID": "@parameters('abstractVendorAccountId')",
                  "accept": "application/json"
                },
                "queries": {
                  "page_number": "1",
                  "page_size": "200",
                  "sort": "-created_at"
                }
              },
              "runAfter": {
                "Get_Abstract_key": [
                  "Succeeded"
                ]
              }
            },
            "Shape_Insights": {
              "type": "Select",
              "runAfter": {
                "Get_Insights": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "from": "@coalesce(body('Get_Insights')?['insights'], json('[]'))",
                "select": {
                  "InsightId": "@coalesce(item()?['nanoid'], string(item()?['id']), '')",
                  "Title": "@coalesce(item()?['title'], '')",
                  "Status": "@coalesce(item()?['status'], '')",
                  "Severity": "@coalesce(item()?['severity'], '')",
                  "PriorityScore": "@coalesce(item()?['priority_score']?['score'], '')",
                  "Categories": "@join(coalesce(item()?['categories'], json('[]')), ',')",
                  "MitreTechniques": "@string(coalesce(item()?['mitre_attack_techniques'], json('[]')))",
                  "CountEvents": "@coalesce(item()?['count_events'], 0)",
                  "Resolution": "@coalesce(item()?['resolution'], '')",
                  "AbstractTimestamp": "@coalesce(item()?['created_at'], utcNow())"
                }
              }
            },
            "Send_Insights": {
              "type": "ApiConnection",
              "runAfter": {
                "Shape_Insights": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['azureloganalyticsdatacollector']['connectionId']"
                  }
                },
                "method": "post",
                "path": "/api/logs",
                "body": "@body('Shape_Insights')",
                "headers": {
                  "Log-Type": "AbstractInsights",
                  "time-generated-field": "AbstractTimestamp"
                }
              }
            },
            "Get_TuningFilters": {
              "type": "Http",
              "runtimeConfiguration": {
                "secureData": {
                  "properties": [
                    "inputs"
                  ]
                }
              },
              "inputs": {
                "method": "GET",
                "uri": "@{parameters('abstractBaseUrl')}/v2/rule-tuning-filters/",
                "headers": {
                  "Authorization": "Bearer @{body('Get_Abstract_key')?['value']}",
                  "X-AS-Vendor-Account-ID": "@parameters('abstractVendorAccountId')",
                  "accept": "application/json"
                },
                "queries": {
                  "page_number": "1",
                  "page_size": "200"
                }
              },
              "runAfter": {
                "Get_Abstract_key": [
                  "Succeeded"
                ]
              }
            },
            "Shape_TuningFilters": {
              "type": "Select",
              "runAfter": {
                "Get_TuningFilters": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "from": "@coalesce(body('Get_TuningFilters')?['items'], json('[]'))",
                "select": {
                  "FilterId": "@coalesce(item()?['nanoid'], '')",
                  "Title": "@coalesce(item()?['title'], '')",
                  "AppliedRuleCount": "@coalesce(item()?['applied_rule_count'], 0)",
                  "Combination": "@coalesce(item()?['tuning_filter_combination']?['combination'], '')",
                  "ConditionCount": "@length(coalesce(item()?['tuning_filter_combination']?['conditions'], json('[]')))",
                  "AbstractTimestamp": "@utcNow()"
                }
              }
            },
            "Send_TuningFilters": {
              "type": "ApiConnection",
              "runAfter": {
                "Shape_TuningFilters": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['azureloganalyticsdatacollector']['connectionId']"
                  }
                },
                "method": "post",
                "path": "/api/logs",
                "body": "@body('Shape_TuningFilters')",
                "headers": {
                  "Log-Type": "AbstractTuningFilters",
                  "time-generated-field": "AbstractTimestamp"
                }
              }
            },
            "Window": {
              "type": "Compose",
              "inputs": {
                "start": "@{addDays(utcNow(), -30)}",
                "end": "@{utcNow()}"
              },
              "runAfter": {
                "Get_Abstract_key": [
                  "Succeeded"
                ]
              }
            },
            "Get_Metrics_SOURCE": {
              "type": "Http",
              "runtimeConfiguration": {
                "secureData": {
                  "properties": [
                    "inputs"
                  ]
                }
              },
              "inputs": {
                "method": "POST",
                "uri": "@{parameters('abstractBaseUrl')}/v3/pipelines/metrics/",
                "headers": {
                  "Authorization": "Bearer @{body('Get_Abstract_key')?['value']}",
                  "X-AS-Vendor-Account-ID": "@parameters('abstractVendorAccountId')",
                  "accept": "application/json",
                  "Content-Type": "application/json"
                },
                "body": {
                  "pipeline_ids": [],
                  "category": "SOURCE",
                  "keys": [],
                  "start_time": "@{outputs('Window')['start']}",
                  "end_time": "@{outputs('Window')['end']}"
                }
              },
              "runAfter": {
                "Window": [
                  "Succeeded"
                ]
              }
            },
            "Get_Metrics_DESTINATION": {
              "type": "Http",
              "runtimeConfiguration": {
                "secureData": {
                  "properties": [
                    "inputs"
                  ]
                }
              },
              "inputs": {
                "method": "POST",
                "uri": "@{parameters('abstractBaseUrl')}/v3/pipelines/metrics/",
                "headers": {
                  "Authorization": "Bearer @{body('Get_Abstract_key')?['value']}",
                  "X-AS-Vendor-Account-ID": "@parameters('abstractVendorAccountId')",
                  "accept": "application/json",
                  "Content-Type": "application/json"
                },
                "body": {
                  "pipeline_ids": [],
                  "category": "DESTINATION",
                  "keys": [],
                  "start_time": "@{outputs('Window')['start']}",
                  "end_time": "@{outputs('Window')['end']}"
                }
              },
              "runAfter": {
                "Window": [
                  "Succeeded"
                ]
              }
            },
            "Shape_Metrics": {
              "type": "Compose",
              "runAfter": {
                "Get_Metrics_SOURCE": [
                  "Succeeded",
                  "Failed"
                ],
                "Get_Metrics_DESTINATION": [
                  "Succeeded",
                  "Failed"
                ]
              },
              "inputs": [
                {
                  "Category": "SOURCE",
                  "Metrics": "@string(body('Get_Metrics_SOURCE'))",
                  "AbstractTimestamp": "@utcNow()"
                },
                {
                  "Category": "DESTINATION",
                  "Metrics": "@string(body('Get_Metrics_DESTINATION'))",
                  "AbstractTimestamp": "@utcNow()"
                }
              ]
            },
            "Send_Metrics": {
              "type": "ApiConnection",
              "runAfter": {
                "Shape_Metrics": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['azureloganalyticsdatacollector']['connectionId']"
                  }
                },
                "method": "post",
                "path": "/api/logs",
                "body": "@outputs('Shape_Metrics')",
                "headers": {
                  "Log-Type": "AbstractPipelineMetrics",
                  "time-generated-field": "AbstractTimestamp"
                }
              }
            },
            "Get_DetectionEff": {
              "type": "Http",
              "runtimeConfiguration": {
                "secureData": {
                  "properties": [
                    "inputs"
                  ]
                }
              },
              "inputs": {
                "method": "GET",
                "uri": "@{parameters('abstractBaseUrl')}/v2/rules/detection-effectiveness",
                "headers": {
                  "Authorization": "Bearer @{body('Get_Abstract_key')?['value']}",
                  "X-AS-Vendor-Account-ID": "@parameters('abstractVendorAccountId')",
                  "accept": "application/json"
                }
              },
              "runAfter": {
                "Get_Abstract_key": [
                  "Succeeded"
                ]
              }
            },
            "Send_DetectionEff": {
              "type": "ApiConnection",
              "runAfter": {
                "Get_DetectionEff": [
                  "Succeeded",
                  "Failed"
                ]
              },
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['azureloganalyticsdatacollector']['connectionId']"
                  }
                },
                "method": "post",
                "path": "/api/logs",
                "body": "@array(setProperty(if(equals(coalesce(body('Get_DetectionEff'),''),''), json('{}'), json('{}')), 'AbstractTimestamp', utcNow()))",
                "headers": {
                  "Log-Type": "AbstractDetectionEffectiveness",
                  "time-generated-field": "AbstractTimestamp"
                }
              }
            },
            "Get_Abstract_key": {
              "type": "Http",
              "runtimeConfiguration": {
                "secureData": {
                  "properties": [
                    "outputs"
                  ]
                }
              },
              "inputs": {
                "method": "GET",
                "uri": "@{parameters('keyVaultSecretUri')}",
                "authentication": {
                  "type": "ManagedServiceIdentity",
                  "audience": "https://vault.azure.net"
                }
              },
              "runAfter": {}
            }
          }
        },
        "parameters": {
          "$connections": {
            "value": {
              "azureloganalyticsdatacollector": {
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('c'))]",
                "connectionName": "[variables('c')]",
                "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/azureloganalyticsdatacollector')]"
              }
            }
          },
          "abstractBaseUrl": {
            "value": "[parameters('abstractBaseUrl')]"
          },
          "abstractVendorAccountId": {
            "value": "[parameters('abstractVendorAccountId')]"
          },
          "pollFrequencyMinutes": {
            "value": "[parameters('pollFrequencyMinutes')]"
          },
          "keyVaultSecretUri": {
            "value": "[parameters('keyVaultSecretUri')]"
          }
        }
      }
    }
  ]
}