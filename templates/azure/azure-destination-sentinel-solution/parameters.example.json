      "value": 14
    },
    "discoveryDeviceDays": {
      "value": 1
    },
    "discoveryProfileTopTables": {
      "value": 25
    },
    "discoverySkipRuleQueryText": {
      "value": true
    },
    "discoverySkipContentQueryText": {
      "value": true
    },
    "discoveryDeployWorkbook": {
      "value": false
    },
    "discoverySendToAbstract": {
      "value": false
    },
    "discoveryStorageAccountName": {
      "value": "abstractdiscovery01"
    },
    "discoveryAssignSubscriptionReader": {
      "value": true
    },
    "discoveryGrantDeployerBlobRead": {
      "value": true
    },
    "discoveryRbacWaitMinutes": {
      "value": 30
    }
