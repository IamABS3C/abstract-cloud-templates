{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "value": "eastus"
    },
    "createWorkspace": {
      "value": false
    },
    "workspaceName": {
      "value": "sentinel-prod"
    },
    "workspaceRetentionDays": {
      "value": 180
    },
    "existingWorkspaceLocation": {
      "value": "eastus2"
    },
    "tags": {
      "value": {
