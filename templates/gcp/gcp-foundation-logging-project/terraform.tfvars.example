# FALSE (default) only enables APIs on an existing project. TRUE also creates it, which needs
# project-creator rights; billing_account_id is optional (see its description).
# create_project = false

# Project ID to use, or to create when create_project = true (globally unique, 6-30 characters,
# lowercase).
project_id = "PROJECT_ID"

# Display name when creating the project.
# project_name = "Abstract Security Logging"

# Organization to create the project under (create_project = true). Find it with: gcloud
# organizations list
# org_id = ""

# Create the project under this folder instead of directly under the organization.
# folder_id = ""

# Billing account to link when create_project = true. The log pipeline itself was measured
# delivering on a project with billing disabled (docs/public/gcp/VERIFIED.md), but an API that
# requires billing cannot be enabled without one. Find it with: gcloud billing accounts list
# billing_account_id = ""

# Also enable the Admin SDK API, for gcp-source-google-workspace-logs.
# enable_workspace_api = false

# Also enable the Security Command Center API, for gcp-source-security-command-center-findings.
# enable_scc_api = false

# Labels applied to every resource this template creates.
# labels = {}
